APP_NAME="Remedic Core API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://core.remedic.it/

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=remedic_core
DB_USERNAME=root
DB_PASSWORD=
OLD_DB_CONNECTION=mysql
OLD_DB_HOST=127.0.0.1
OLD_DB_PORT=3307
OLD_DB_DATABASE=
OLD_DB_USERNAME=root
OLD_DB_PASSWORD=
OLD_DB_SOCKET=
OLD_DB_URL=
OLD_DB_CHARSET=utf8mb4
OLD_DB_COLLATION=utf8mb4_unicode_ci
OLD_DB_FOREIGN_KEYS=true

FRONTEND_URL=https://remedic-core-ui.vercel.app/
CORS_ALLOWED_ORIGINS=https://remedic-core-ui.vercel.app
PRIMARY_ADMIN_EMAIL=humancaretelemedicine@gmail.com
PRIMARY_ADMIN_NAME=Remedic
PRIMARY_ADMIN_LAST_NAME=Admin
PRIMARY_ADMIN_PASSWORD=
ACCESS_APPROVAL_LINK_EXPIRE_MINUTES=10080
ACCESS_APPROVAL_DISPLAY_TIMEZONE=Europe/Rome

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="amministrazione@remedic.local"
MAIL_FROM_NAME="${APP_NAME}"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=REMEDIC
TWILIO_DEFAULT_COUNTRY_CODE=+39
GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT="RemedicCore/1.0 (+https://core.remedic.it)"
GEOCODING_TIMEOUT_SECONDS=8
# Transitional fallback only; configure the Center profile in Management.
MARKETING_REMEDIC_ADDRESS="Via Salvatore Vigo 97/H, Acireale, 95024"
MARKETING_REMEDIC_LAT=37.6108
MARKETING_REMEDIC_LNG=15.1659

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
